# Base image for Dockerfile.firstmate. Copied verbatim from the agent-box Dockerfile at commit 53cf4113910c817e81be891d8f0ebdc1bbc1074e.
# tested 2026-10-13; bump these together and rerun the checks in docs/DECISIONS.md
FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 python3-pip curl ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*

# non-root so files written to the bind mount belong to the host user (node is uid 1000)
USER node
ENV HOME=/home/node \
    NPM_CONFIG_PREFIX=/home/node/.npm-global \
    PATH=/home/node/.npm-global/bin:/home/node/.local/bin:$PATH

ARG CLAUDE_CODE_VERSION=2.1.296
ARG PI_VERSION=0.73.1
ARG PNPM_VERSION=12.11.2
ARG UV_VERSION=0.13.0
RUN npm install -g "pnpm@${PNPM_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@mariozechner/pi-coding-agent@${PI_VERSION}"  && curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh

ENV CLAUDE_CONFIG_DIR=/home/node/.claude

# config/cache dirs created as node so fresh named volumes are writable
RUN mkdir -p /home/node/.claude /home/node/.pi /home/node/.pnpm-store /home/node/.cache/uv
WORKDIR /code
